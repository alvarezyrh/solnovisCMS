<%- include('partials/site-header', { title: 'Post', description: 'Artikel dan informasi terbaru dari Solnovis.', activeSlug: '', menuItems: menuItems, setting: setting }) %>
<main>
    <section class="page-hero section-wrap">
        <p class="eyebrow">Jurnal Solnovis</p>
        <h1>Wawasan dan kabar<br><em>komoditas Indonesia.</em></h1>
        <p class="page-lead">Informasi terbaru seputar produk, sumber lokal, dan perdagangan komoditas.</p>
    </section>
    <section class="commodity-section section-wrap">
        <% if (posts && posts.length > 0) { %>
            <div class="info-grid">
                <% posts.forEach(function(post) { %>
                    <article class="info-card">
                        <span><%= formatDate(post.created_at) %></span>
                        <h3><%= post.title %></h3>
                        <p><%= post.excerpt %></p>
                        <a class="text-link" href="/post/<%= encodeURIComponent(post.slug) %>">Baca selengkapnya <span aria-hidden="true">→</span></a>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div class="product-note"><span class="note-icon" aria-hidden="true">i</span><p>Belum ada post yang diterbitkan. Silakan kembali untuk membaca informasi terbaru.</p></div>
        <% } %>
    </section>
</main>
<%- include('partials/site-footer', { setting: setting }) %>
