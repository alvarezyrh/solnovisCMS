                            <label>Nama Perusahaan / Importir <span>*</span>
                                <input type="text" name="company" required placeholder="Contoh: Global Spice Traders Ltd.">
                            </label>
                        </div>
                        <div class="form-row">
                            <label>Alamat Email Perusahaan <span>*</span>
                                <input type="email" name="email" required placeholder="name@company.com">
                            </label>
                            <label>Nomor Telepon / WhatsApp <span>*</span>
                                <input type="text" name="phone" required placeholder="+62 / +1 / +86 ...">
                            </label>
                        </div>
                        <div class="form-row">
