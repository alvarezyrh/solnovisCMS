<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title><%= title %> | Dashboard Admin Web SOLNOVIS</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin.css">
</head>
<body class="admin-body">
    <header class="admin-topbar">
        <a class="admin-brand" href="/admin">
            <span class="brand-mark">S</span>
            <span class="admin-brand-title">Dashboard Admin Web <small>SOLNOVIS</small></span>
        </a>
        <div class="admin-user">
            <span><%= currentUser ? currentUser.name : '' %></span>
            <form method="post" action="/admin/logout">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <button type="submit">Keluar</button>
            </form>
        </div>
    </header>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <p class="admin-label">Dashboard</p>
            <a class="<%= active === 'dashboard' ? 'current' : '' %>" href="/admin">Ringkasan</a>
            <a class="<%= active === 'posts' ? 'current' : '' %>" href="/admin/manage?type=posts">Post</a>
            <a class="<%= active === 'pages' ? 'current' : '' %>" href="/admin/manage?type=pages">Halaman</a>
            <a class="<%= active === 'menus' ? 'current' : '' %>" href="/admin/manage?type=menus">Menu</a>
            <a class="<%= active === 'sliders' ? 'current' : '' %>" href="/admin/manage?type=hero_slides">Slider Hero</a>
            <% if (currentUser && currentUser.role === 'admin') { %>
                <a class="<%= active === 'settings' ? 'current' : '' %>" href="/admin/settings">Settings</a>
                <a class="<%= active === 'profiles' ? 'current' : '' %>" href="/admin/manage?type=profiles">Profiles</a>
            <% } %>
            <a class="admin-view-site" href="/" target="_blank" rel="noopener">Lihat website ↗</a>
        </aside>
        <main class="admin-main">
            <div class="admin-page-heading">
                <p class="eyebrow">Dashboard Admin Web SOLNOVIS</p>
                <h1><%= title %></h1>
            </div>
            <% if (flash) { %>
                <p class="admin-alert <%= flash.type %>" role="status"><%= flash.message %></p>
            <% } %>
