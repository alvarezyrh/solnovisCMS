<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= description %>">
    <meta name="theme-color" content="#102c27">
    <title><%= title %> | <%= setting('site_name', 'PT Solnovis Main Global') %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <script src="/script.js" defer></script>
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/" aria-label="<%= setting('site_name', 'PT Solnovis Main Global') %>, beranda">
            <span class="brand-mark" aria-hidden="true">S</span>
            <span class="brand-name"><%= setting('site_name', 'PT Solnovis Main Global').toUpperCase() %></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Buka menu navigasi"><span></span><span></span></button>
        <nav class="primary-nav" id="primary-nav" aria-label="Navigasi utama">
            <% menuItems.forEach(function(item) { 
                let slug = '';
                const match = item.url.match(/[?&]slug=([a-z0-9-]+)/);
                if (match) {
                    slug = match[1];
                } else if (item.url === 'index.php' || item.url === '/') {
                    slug = 'home';
                }
                const isActive = (slug !== '' && slug === activeSlug);
            %>
                <a class="<%= item.is_cta === 1 ? 'nav-cta ' : '' %><%= isActive ? 'active' : '' %>" href="<%= item.url.startsWith('page.php?slug=') ? '/page/' + item.url.split('slug=')[1] : (item.url === 'index.php' ? '/' : item.url) %>"<%= isActive ? ' aria-current="page"' : '' %>><%= item.label %><%= item.is_cta === 1 ? ' <span aria-hidden="true">↗</span>' : '' %></a>
            <% }); %>
        </nav>
    </header>
